# Local development. On Vercel, set both in the project's Environment
# Variables (they're baked in at build time), and add the production origin
# (e.g. https://pathshala.vercel.app) to the Google OAuth client's
# "Authorized JavaScript origins" and to the API's FRONTEND_URL.
VITE_API_URL=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
