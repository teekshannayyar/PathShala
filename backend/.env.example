DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/pathshala
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Allowed browser origins, comma-separated (no trailing slash needed), e.g.
# FRONTEND_URL=https://pathshala.example.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Vector store: persistent (on disk at CHROMA_PATH), http (a Chroma server),
# cloud (Chroma Cloud) or ephemeral (in memory, lost on restart).
CHROMA_MODE=persistent
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=pathshala_docs
# CHROMA_MODE=http needs CHROMA_HOST; CHROMA_API_KEY is sent as x-chroma-token.
# CHROMA_HOST=chroma.example.internal
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_MODE=cloud needs CHROMA_API_KEY; tenant and database are optional.
# CHROMA_API_KEY=your-chroma-api-key
# CHROMA_TENANT=your-tenant-id
# CHROMA_DATABASE=your-database-name
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Set to "fake" to use a deterministic hash embedder instead of downloading the
# sentence-transformers model (offline development and tests). Retrieval quality
# is much lower, so leave it unset for real use.
# EMBEDDING_BACKEND=fake
# Per-IP rate limits (login/register/Google 10/min, password change 10/hour,
# chat 30/min, quiz generation 10/hour, upload 20/hour).
RATE_LIMIT_ENABLED=true
# Empty = in-process memory (per worker). Set e.g. redis://localhost:6379 (needs
# the redis package, not installed by default) to
# share counters across workers or instances.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# Header with the real client IP for rate limits, set by your edge proxy (e.g.
# cf-connecting-ip on Render/Cloudflare). Leave unset when clients connect
# directly; only set it if the proxy always overwrites that header.
# CLIENT_IP_HEADER=cf-connecting-ip
# Docker image only: proxy addresses uvicorn trusts for X-Forwarded-For.
# Default 127.0.0.1. Avoid "*": the left-most entry is client-controlled.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Docker image only: the port uvicorn listens on (Render sets this itself).
# PORT=8000
# Tests only: pytest reads TEST_DATABASE_URL from the shell environment, not
# from this file. The database name must end in _test (it is wiped).
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pathshala_test
